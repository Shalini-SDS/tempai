MONGODB_URI=mongodb://localhost:27017/emergency_db
PORT=5000
NODE_ENV=development

# Email Configuration (Gmail - Free, No API Key Required)
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# Alternative: Use any SMTP server (Outlook, Custom SMTP, etc.)
# EMAIL_SERVICE=custom
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# EMAIL_USER=your_email@example.com
# EMAIL_PASSWORD=your_password_here

# Hospital Notification Email (Optional - for sending alerts to nearby hospitals)
# Leave empty to use EMAIL_USER
HOSPITAL_NOTIFICATION_EMAIL=hospital_alerts@example.com

# Twilio Configuration (Optional - for future SMS/Call integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=+1234567890
EMERGENCY_CONTACT_PHONE=+1234567890
